<script>
  const applyLang = (lang: string) => {
    document.documentElement.setAttribute('data-lang', lang)
    // data-lang は表示切替用。読み上げ音声は lang 属性でしか切り替わらない
    document.documentElement.lang = lang === 'en' ? 'en' : 'ja'
    document.querySelectorAll<HTMLElement>('[data-lang-set]').forEach(button => {
      button.classList.toggle('on', button.dataset.langSet === lang)
      button.setAttribute('aria-pressed', String(button.dataset.langSet === lang))
    })
  }
  applyLang(document.documentElement.getAttribute('data-lang') ?? 'jp')
  const narrow = window.matchMedia('(max-width: 760px)')
  const navDisclosure = document.querySelector<HTMLDetailsElement>('.nav-disclosure')
  if (navDisclosure) {
    // summary はデスクトップでは非表示にするため、閉じたままだとナビが消える
    narrow.addEventListener('change', () => { navDisclosure.open = !narrow.matches })
    // ページ内リンクなので、開いたままだと飛んだ先がメニューに隠れる
    navDisclosure.querySelectorAll('a').forEach(link => {
      link.addEventListener('click', () => { if (narrow.matches) navDisclosure.open = false })
    })
  }

  document.querySelectorAll<HTMLElement>('[data-lang-set]').forEach(button => {
    button.addEventListener('click', () => {
      const lang = button.dataset.langSet ?? 'jp'
      applyLang(lang)
      try {
        localStorage.setItem('mjt-lang', lang)
      } catch (error) { /* 保存できなくても表示は切り替わる */ }
    })
  })

  // タブ群はページ内に複数あるため、切り替えは [data-tabs] の中だけに閉じる
  document.querySelectorAll<HTMLElement>('[data-tabs]').forEach(group => {
    const tabs = [...group.querySelectorAll<HTMLElement>('.fw-tab')]
    const select = (tab: HTMLElement) => {
      const selected = tab.dataset.fw
      tabs.forEach(other => {
        const on = other.dataset.fw === selected
        other.classList.toggle('on', on)
        other.setAttribute('aria-selected', String(on))
        // ロービングタブインデックス: タブ群全体を Tab キー1回で通過させる
        other.tabIndex = on ? 0 : -1
      })
      group.querySelectorAll<HTMLElement>('.fw-panel').forEach(panel => {
        panel.classList.toggle('on', panel.dataset.panel === selected)
      })
    }
    tabs.forEach((tab, index) => {
      tab.addEventListener('click', () => select(tab))
      tab.addEventListener('keydown', event => {
        const step = { ArrowRight: 1, ArrowLeft: -1, Home: -index, End: tabs.length - 1 - index }[event.key]
        if (step === undefined) return
        event.preventDefault()
        const next = tabs[(index + step + tabs.length) % tabs.length]
        select(next)
        next.focus()
      })
    })
  })

  document.querySelectorAll<HTMLButtonElement>('.copy-btn').forEach(button => {
    // 連打してもラベルが 'COPIED!' のまま固まらないよう、元の文言は最初に控える
    const original = button.textContent
    button.addEventListener('click', async () => {
      // <pre> は .hdr の兄弟なので、ボタンの親ではなく .codeblock から辿る
      const code = button.closest('.codeblock')?.querySelector('pre')
      const text = button.dataset.copyText ?? code?.innerText ?? ''
      // 空文字を書くとクリップボードを消してしまう
      if (!text) return
      try {
        await navigator.clipboard.writeText(text)
        button.textContent = 'COPIED!'
        setTimeout(() => { button.textContent = original }, 1200)
      } catch (error) { /* コピーできない環境ではラベルを変えない */ }
    })
  })
</script>

